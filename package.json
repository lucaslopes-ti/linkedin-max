    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1",
    "nunjucks": "^3.2.4",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
